# Environment variable examples for Mission-Distinction
# Copy this file to .env when running locally and fill real values.

# Frontend (Vite) envs (prefix VITE_ for client exposure)
VITE_POSTHOG_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA_MEASUREMENT_ID=G-XXXXXXX

# External services
SUPABASE_URL=https://your-supabase.example
SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend envs
DATABASE_URL=postgres://user:password@db:5432/mission
NODE_ENV=development
PORT=3001
JWT_SECRET=supersecretjwtkey

# Optional / integrations
SENTRY_DSN=
CLOUDINARY_URL=
RESEND_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Do NOT commit real secrets into the repository. Use Vercel/Render/CI secrets management.
